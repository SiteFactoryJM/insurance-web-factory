{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitefactory.example/schemas/insurance-site.json",
  "title": "Insurance Web Factory site configuration",
  "type": "object",
  "required": [
    "id",
    "status",
    "domains",
    "template",
    "headingFont",
    "agent",
    "hero",
    "intro",
    "specialties",
    "process",
    "career",
    "faqs",
    "contact",
    "sections",
    "seo",
    "compliance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "template": {
      "enum": [
        "trust-blue",
        "warm-care",
        "premium-navy",
        "clean-minimal",
        "local-friendly"
      ]
    },
    "accentColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "headingFont": {
      "enum": [
        "pretendard",
        "noto-serif-kr",
        "noto-sans-kr",
        "nanum-gothic",
        "nanum-myeongjo",
        "gowun-batang"
      ]
    },
    "agent": {
      "type": "object",
      "properties": {
        "businessNumber": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "hero": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "description": "Optional decorative JPG, PNG, or WebP image."
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "subheadline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "mobileHeadline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "mobileSubheadline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      }
    },
    "intro": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "body": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "mobileTitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "mobileBody": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        }
      }
    },
    "specialties": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/draftContentCard"
      },
      "maxItems": 12
    },
    "process": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/draftContentCard"
      },
      "minItems": 0,
      "maxItems": 12
    },
    "career": {
      "type": "array"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/draftReviewItem"
      },
      "minItems": 0,
      "maxItems": 12
    },
    "faqs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/draftFaqItem"
      },
      "minItems": 0,
      "maxItems": 12
    },
    "contact": {
      "type": "object"
    },
    "sections": {
      "type": "object"
    },
    "seo": {
      "type": "object"
    },
    "compliance": {
      "type": "object"
    },
    "demo": {
      "type": "object"
    },
    "palette": {
      "enum": [
        "navy",
        "forest",
        "slate",
        "charcoal",
        "teal",
        "stone"
      ]
    },
    "design": {
      "type": "object",
      "properties": {
        "hero": {
          "enum": [
            "portrait",
            "editorial",
            "statement"
          ]
        },
        "services": {
          "enum": [
            "cards",
            "list",
            "split"
          ]
        },
        "about": {
          "enum": [
            "editorial",
            "profile",
            "quote"
          ]
        },
        "process": {
          "enum": [
            "steps",
            "timeline"
          ]
        },
        "faq": {
          "enum": [
            "accordion",
            "columns"
          ]
        },
        "footer": {
          "enum": [
            "classic",
            "columns",
            "minimal"
          ]
        },
        "ornament": {
          "enum": [
            "line",
            "grid",
            "none"
          ]
        },
        "density": {
          "enum": [
            "airy",
            "compact"
          ]
        },
        "sectionOrder": {
          "$ref": "#/$defs/designSections"
        },
        "hiddenSections": {
          "$ref": "#/$defs/designSections"
        }
      },
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 400
        }
      },
      "additionalProperties": false
    },
    "templateContent": {
      "type": "object",
      "properties": {
        "trust-blue": {
          "$ref": "#/$defs/templateContent"
        },
        "warm-care": {
          "$ref": "#/$defs/templateContent"
        },
        "premium-navy": {
          "$ref": "#/$defs/templateContent"
        },
        "clean-minimal": {
          "$ref": "#/$defs/templateContent"
        },
        "local-friendly": {
          "$ref": "#/$defs/templateContent"
        }
      },
      "additionalProperties": false
    },
    "consultation": {
      "type": "object",
      "properties": {
        "topics": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 60
          }
        }
      },
      "additionalProperties": false
    },
    "contentBrief": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "targetAudience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "primaryAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "designSections": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "services",
          "about",
          "process",
          "reviews",
          "faq",
          "contact"
        ]
      }
    },
    "templateContent": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "subheadline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "focusTitle": {
          "type": "string",
          "minLength": 1
        },
        "specialties": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/contentCard"
          }
        },
        "process": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/contentCard"
          }
        },
        "focus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/contentCard"
          }
        },
        "faqs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/faqItem"
          }
        },
        "mobileHeadline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "mobileSubheadline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "additionalProperties": false
    },
    "contentCard": {
      "type": "object",
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "mobileBody": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        }
      },
      "additionalProperties": false
    },
    "faqItem": {
      "type": "object",
      "required": [
        "question",
        "answer"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "mobileAnswer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
    "draftContentCard": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 0
        },
        "body": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "mobileBody": {
          "type": "string",
          "minLength": 0,
          "maxLength": 48
        }
      },
      "additionalProperties": false
    },
    "draftFaqItem": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 0
        },
        "answer": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "mobileAnswer": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
    "reviewItem": {
      "type": "object",
      "required": [
        "quote",
        "author"
      ],
      "properties": {
        "quote": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "isExample": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "draftReviewItem": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 0
        },
        "author": {
          "type": "string",
          "minLength": 0
        },
        "context": {
          "type": "string",
          "minLength": 0
        },
        "isExample": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "design"
          ],
          "properties": {
            "design": {
              "required": [
                "hiddenSections"
              ],
              "properties": {
                "hiddenSections": {
                  "contains": {
                    "const": "about"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "intro": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "mobileTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "mobileBody": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "title",
              "body"
            ]
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "design"
          ],
          "properties": {
            "design": {
              "required": [
                "hiddenSections"
              ],
              "properties": {
                "hiddenSections": {
                  "contains": {
                    "const": "services"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "specialties"
        ],
        "properties": {
          "specialties": {
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/contentCard"
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "not": {
              "required": [
                "design"
              ],
              "properties": {
                "design": {
                  "required": [
                    "hiddenSections"
                  ],
                  "properties": {
                    "hiddenSections": {
                      "contains": {
                        "const": "process"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "required": [
              "sections"
            ],
            "properties": {
              "sections": {
                "required": [
                  "process"
                ],
                "properties": {
                  "process": {
                    "const": true
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "process"
        ],
        "properties": {
          "process": {
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/contentCard"
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "not": {
              "required": [
                "design"
              ],
              "properties": {
                "design": {
                  "required": [
                    "hiddenSections"
                  ],
                  "properties": {
                    "hiddenSections": {
                      "contains": {
                        "const": "faq"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "required": [
              "sections"
            ],
            "properties": {
              "sections": {
                "required": [
                  "faq"
                ],
                "properties": {
                  "faq": {
                    "const": true
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "faqs"
        ],
        "properties": {
          "faqs": {
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/faqItem"
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "not": {
              "required": [
                "design"
              ],
              "properties": {
                "design": {
                  "required": [
                    "hiddenSections"
                  ],
                  "properties": {
                    "hiddenSections": {
                      "contains": {
                        "const": "reviews"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "required": [
              "sections"
            ],
            "properties": {
              "sections": {
                "required": [
                  "reviews"
                ],
                "properties": {
                  "reviews": {
                    "const": true
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "reviews"
        ],
        "properties": {
          "reviews": {
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/reviewItem"
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "design"
          ],
          "properties": {
            "design": {
              "required": [
                "hiddenSections"
              ],
              "properties": {
                "hiddenSections": {
                  "contains": {
                    "const": "contact"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "consultation": {
            "properties": {
              "topics": {
                "minItems": 1,
                "items": {
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
