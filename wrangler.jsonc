{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insurance-web-factory-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DEMO_SITE_ID": "demo-agent"
  }
}
